# ── Обязательные ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=токен_от_@BotFather
ANTHROPIC_API_KEY=ключ_Anthropic

# ── Владелец ──────────────────────────────────────────────────────────────────
# Вариант 1: укажите свой Telegram user id (узнать у @userinfobot).
# Вариант 2: оставьте 0 — при первом запуске бот выведет в консоль секрет,
#            отправьте боту /claim <секрет> и станете владельцем.
OWNER_CHAT_ID=0
# Имя владельца — подставляется в промпт и в фильтры от имени владельца.
OWNER_NAME=
# Имя бота (как он представляется).
BOT_NAME=Секретарь
# Подпись в конце ответов (пусто = без подписи). Пример: С уважением,\nСекретарь
BOT_SIGNATURE=

# ── Notion (для сохранения задач, необязательно) ──────────────────────────────
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ── Необязательные ────────────────────────────────────────────────────────────
# Модель Claude (по умолчанию claude-haiku-4-5)
CLAUDE_MODEL=claude-haiku-4-5
# Модель Whisper для распознавания голоса: tiny | base | small | medium
WHISPER_MODEL=tiny
# Часовой пояс (IANA), например Europe/Moscow, Asia/Bangkok
TIMEZONE=UTC
# Каталог для логов и данных (по умолчанию — папка рядом с bot.py)
# DATA_DIR=

# ── Режим связи ───────────────────────────────────────────────────────────────
# polling (по умолчанию) — работает на любом ПК без публичного IP.
# webhook — только для сервера с публичным HTTPS-адресом.
BOT_MODE=polling

# Параметры webhook (нужны только при BOT_MODE=webhook):
# WEBHOOK_URL=https://example.com:8443/webhook
# WEBHOOK_PORT=8443
# WEBHOOK_PATH=/webhook
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_SECRET_TOKEN=придумайте_длинную_случайную_строку
# WEBHOOK_CERT=/path/to/webhook.pem
# WEBHOOK_KEY=/path/to/webhook.key
