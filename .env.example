# ── Обязательные ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=токен_от_@BotFather
ANTHROPIC_API_KEY=ключ_Anthropic

# ── Рекомендуемые ─────────────────────────────────────────────────────────────
# Ваш Telegram user id (узнать у @userinfobot). Нужен для команд Руслана и уведомлений.
OWNER_CHAT_ID=0

# ── Notion (для сохранения задач) ─────────────────────────────────────────────
NOTION_TOKEN=
NOTION_DATABASE_ID=28045a40e63a8063840a000b21ad294a

# ── Необязательные ────────────────────────────────────────────────────────────
# Модель Claude (по умолчанию claude-haiku-4-5)
CLAUDE_MODEL=claude-haiku-4-5
# Модель Whisper для распознавания голоса: tiny | base | small | medium
WHISPER_MODEL=tiny
# Каталог для логов и данных (по умолчанию — папка рядом с bot.py)
# DATA_DIR=

# ── Режим связи ───────────────────────────────────────────────────────────────
# polling (по умолчанию) — работает на любом ПК без публичного IP.
# webhook — только для сервера с публичным HTTPS-адресом.
BOT_MODE=polling

# Параметры webhook (нужны только при BOT_MODE=webhook):
# WEBHOOK_URL=https://example.com:8443/webhook
# WEBHOOK_PORT=8443
# WEBHOOK_PATH=/webhook
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_SECRET_TOKEN=придумайте_длинную_случайную_строку
# WEBHOOK_CERT=/path/to/webhook.pem
# WEBHOOK_KEY=/path/to/webhook.key
