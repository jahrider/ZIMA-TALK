# ── Обязательные ──────────────────────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# API-ключ Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Ваш Telegram user ID (узнать: напишите @userinfobot).
# Сообщения с этого ID бот считает командами владельца.
OWNER_CHAT_ID=

# ── Опциональные ──────────────────────────────────────────────────────────────
# Интеграция с Notion (для задач /task и SAVE_TASK)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Часовой пояс бота (по умолчанию Asia/Bangkok)
BOT_TIMEZONE=Europe/Moscow

# Каталог для данных бота (история, контакты, логи).
# По умолчанию — папка data рядом с bot.py
# BOT_DATA_DIR=/path/to/data

# Режим webhook (для сервера с публичным IP/доменом).
# Если не задан — бот работает через long polling (подходит для локального запуска).
# WEBHOOK_URL=https://example.com:88/webhook
# WEBHOOK_PORT=88
